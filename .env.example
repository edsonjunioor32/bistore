# Application
NEXT_PUBLIC_APP_NAME=Bistore
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_STORE_SLUG=demo

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bistore

# Auth / email
AUTH_SECRET=change-me
RESEND_API_KEY=
EMAIL_FROM=

# Telegram - platform secret used to encrypt/store per-store credentials
TELEGRAM_ENCRYPTION_KEY=

# Optional Supabase compatibility
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
